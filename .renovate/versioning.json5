{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Silo has no releases yet; build-N is an ordered build number, not a version.
      description: "Silo build numbers",
      matchPackageNames: ["ghcr.io/silo-server/silo-server"],
      versioning: "regex:^build-(?<major>\\d+)$",
      // Every build is a major; omit the default newMajor suffix so one PR tracks the newest.
      branchTopic: "{{{depNameSanitized}}}",
    },
  ],
}
