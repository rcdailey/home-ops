{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto-merge pre-commit minor and patch updates",
      matchManagers: ["pre-commit"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
    {
      // Generalized rule at the top so it can be overridden
      // kubectl excluded: it must group with kubelet (Kubernetes group) to prevent
      // version drift that broke kube-scheduler when Talos 1.13.2 shipped 1.36 schema.
      // Match depName: mise's kubectl packageName is kubernetes/kubernetes.
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      matchDepNames: ["!kubectl"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      // Python minor version updates frequently introduce breaking changes to stdlib APIs
      // Example: Python 3.14's BooleanOptionalAction no longer accepts 'type' parameter,
      // breaking CLI tools. Only auto-merge patch versions (security fixes).
      description: "Disable auto-merge for Mise Python minor/major",
      matchManagers: ["mise"],
      matchDepNames: ["python"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      // mise specifies Python as major.minor only (e.g. "3.14") so mise resolves the
      // latest patch at install time. Prevent Renovate from reintroducing patch versions.
      description: "Keep Python at major.minor only in mise",
      matchManagers: ["mise"],
      matchDepNames: ["python"],
      allowedVersions: "/^\\d+\\.\\d+$/",
    },
    {
      description: "Disable auto-merge for all Talos-related packages",
      matchPackageNames: ["/siderolabs/"],
      automerge: false,
    },
  ],
}
