{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Cilium Group",
      groupName: "Cilium",
      matchPackageNames: ["/cilium/"],
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchPackageNames: ["/flux-operator/"],
      minimumGroupSize: 2,
    },
    {
      description: "Immich Group",
      groupName: "Immich",
      matchPackageNames: ["ghcr.io/immich-app/**"],
      minimumGroupSize: 2,
    },
    {
      description: "Rook Ceph Group",
      groupName: "Rook Ceph",
      matchPackageNames: ["ghcr.io/rook/**"],
      minimumReleaseAge: "10 days",
      minimumGroupSize: 2,
    },
    {
      description: "MariaDB Operator",
      groupName: "MariaDB",
      matchPackageNames: ["/mariadb-operator/"],
      minimumGroupSize: 2,
    },
    {
      // Groups Kubernetes version upgrades across mise (kubectl), tuppr, and talenv (kubelet)
      description: "Kubernetes Group",
      groupName: "Kubernetes",
      matchPackageNames: ["/kubelet/", "/kubectl/"],
      minimumGroupSize: 3,
    },
    {
      // Wait for the CLI and both OS references. Patch separation prevents a new minor release
      // from hiding an available patch on the current minor.
      description: "Talos Group",
      groupName: "Talos",
      matchPackageNames: ["ghcr.io/siderolabs/talos", "siderolabs/talos"],
      minimumGroupSize: 3,
      separateMinorPatch: true,
    },
  ],
}
