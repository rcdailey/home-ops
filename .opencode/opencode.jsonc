{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "yaml-ls": {
      "disabled": true
    },
    "yayamlls": {
      "command": ["yayamlls"],
      "extensions": [".yaml", ".yml"]
    }
  },
  "formatter": {
    "yamlfmt": {
      "command": ["yamlfmt", "$FILE"],
      "extensions": [".yaml", ".yml"]
    },
    "shfmt": {
      "disabled": true
    }
  },
  "permissions": [
    { "action": "read", "resource": "*.local", "effect": "deny" },
    { "action": "read", "resource": "*.local.*", "effect": "deny" },
    { "action": "read", "resource": "age.txt", "effect": "deny" },
    { "action": "read", "resource": "*/age.txt", "effect": "deny" },

    // mise decrypts age-encrypted env secrets; block commands that print them or write
    // secrets outside `just secret`
    { "action": "shell", "resource": "*mise env*", "effect": "deny" },
    { "action": "shell", "resource": "*mise set*", "effect": "deny" },
    { "action": "shell", "resource": "*mise e *", "effect": "deny" },
    { "action": "shell", "resource": "*mise e", "effect": "deny" },
    { "action": "shell", "resource": "*mise ev *", "effect": "deny" },
    // Same subcommands after global flags, e.g. `mise -q env`
    { "action": "shell", "resource": "*mise * env*", "effect": "deny" },
    { "action": "shell", "resource": "*mise * e *", "effect": "deny" },
    { "action": "shell", "resource": "*mise * e", "effect": "deny" },
    { "action": "shell", "resource": "*mise * ev *", "effect": "deny" },
    { "action": "shell", "resource": "*mise * set *", "effect": "deny" },
    { "action": "shell", "resource": "*age.txt*", "effect": "deny" },
    { "action": "shell", "resource": "*--no-redact*", "effect": "deny" },
    { "action": "shell", "resource": "*--age-encrypt*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env |*", "effect": "deny" },
    { "action": "shell", "resource": "*printenv*", "effect": "deny" },

    { "action": "shell", "resource": "*git commit*", "effect": "ask" },
    { "action": "shell", "resource": "*git push*", "effect": "allow" },

    { "action": "shell", "resource": "kubectl apply*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl apply -f /tmp/*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl create*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "kubectl create job*--from=cronjob*",
      "effect": "allow"
    },
    { "action": "shell", "resource": "kubectl edit*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl replace*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl label*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl taint*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl cordon*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl uncordon*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl port-forward*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl delete*", "effect": "ask" },

    { "action": "shell", "resource": "talosctl apply-config*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl upgrade*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl reset*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl reboot*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl patch*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl edit*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl bootstrap*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl kubeconfig*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "talosctl etcd forfeit-leadership*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "talosctl etcd remove-member*",
      "effect": "deny"
    },

    { "action": "shell", "resource": "flux install*", "effect": "deny" },
    { "action": "shell", "resource": "flux uninstall*", "effect": "deny" },
    { "action": "shell", "resource": "flux bootstrap*", "effect": "deny" },
    { "action": "shell", "resource": "flux delete*", "effect": "deny" },

    { "action": "shell", "resource": "helm install*", "effect": "deny" },
    { "action": "shell", "resource": "helm template*", "effect": "deny" },
    { "action": "shell", "resource": "helm upgrade*", "effect": "deny" },
    { "action": "shell", "resource": "helm uninstall*", "effect": "deny" },
    { "action": "shell", "resource": "helm rollback*", "effect": "deny" },

    // topf: node-mutating commands denied; dry-run is read-only. `secrets` can generate and
    // store a new bundle.
    { "action": "shell", "resource": "topf apply*", "effect": "deny" },
    { "action": "shell", "resource": "topf apply*--dry-run*", "effect": "allow" },
    { "action": "shell", "resource": "topf upgrade*", "effect": "deny" },
    { "action": "shell", "resource": "topf upgrade*--dry-run*", "effect": "allow" },
    { "action": "shell", "resource": "topf reset*", "effect": "deny" },
    { "action": "shell", "resource": "topf secrets*", "effect": "deny" },

    // just commands: deny by default
    { "action": "shell", "resource": "just *", "effect": "deny" },
    { "action": "shell", "resource": "just ensure-login", "effect": "allow" },
    { "action": "shell", "resource": "just secret *", "effect": "ask" },
    { "action": "shell", "resource": "just talos diff", "effect": "allow" },
    { "action": "shell", "resource": "just talos nodes", "effect": "allow" },
    { "action": "shell", "resource": "just talos etcd-status", "effect": "allow" },
    { "action": "shell", "resource": "just talos topf render*", "effect": "allow" },
    { "action": "shell", "resource": "just talos topf nodes*", "effect": "allow" },
    { "action": "shell", "resource": "just talos topf schematic-ids", "effect": "allow" },
    { "action": "shell", "resource": "just talos topf apply*--dry-run*", "effect": "allow" },
    { "action": "shell", "resource": "just talos topf upgrade*--dry-run*", "effect": "allow" },
    {
      "action": "shell",
      "resource": "just infisical add-secret*",
      "effect": "ask"
    }
  ]
}
