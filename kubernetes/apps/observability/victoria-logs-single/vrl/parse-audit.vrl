# Parser for Kubernetes API audit events written by Talos kube-apiserver.

raw_message = string(.message) ?? ""
.app = "kube-apiserver"
.log_type = "kubernetes-audit"

parsed, err = parse_json(raw_message)
if err != null || !is_object(parsed) {
  .level = "warning"
} else {
  . = merge(., object!(parsed))
  .message = raw_message

  audit_level = del(.level)
  .audit_level = string(audit_level) ?? "Metadata"

  code = int(.responseStatus.code) ?? 0
  if code >= 500 {
    .level = "error"
  } else if code >= 400 {
    .level = "warning"
  } else {
    .level = "info"
  }

  timestamp_raw = if exists(.stageTimestamp) {
    .stageTimestamp
  } else {
    .requestReceivedTimestamp
  }
  event_ts, timestamp_err = parse_timestamp(string(timestamp_raw) ?? "", format: "%+")
  if timestamp_err == null {
    .timestamp = event_ts
  }
}
